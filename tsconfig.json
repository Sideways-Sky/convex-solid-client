{
	"compilerOptions": {
		"strict": true,
		"noImplicitAny": true,
		"esModuleInterop": true,
		"strictNullChecks": true,
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"declaration": true,
		"isolatedModules": true,
		"noEmit": true,
		"outDir": "dist",
		"jsxImportSource": "solid-js",
		"jsx": "preserve"
	},
	"include": ["src"],
	"exclude": ["node_modules"]
}
